// HR Management System - Travel Allowance & Task Management
// Optimized Prisma Schema for High Performance HR Operations

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================
// CORE HR MANAGEMENT MODELS
// ======================================

// Organizations - Multi-tenant support with HR optimization
model Organization {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  code      String?  @unique @db.VarChar(10) // Short organization code
  settings  Json?    // HR policies, expense limits, etc.
  timezone  String   @default("UTC") @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users             User[]
  departments       Department[]
  travelRequests    TravelRequest[]
  valleyRequests    ValleyRequest[]
  expenseItems      ExpenseItem[]
  valleyExpenses    ValleyExpense[]
  receipts          Receipt[]
  valleyReceipts    ValleyReceipt[]
  notifications     Notification[]
  projects          Project[]
  budgets           Budget[]
  tasks             Task[]
  timeLogs          TimeLog[]
  taskActionItems   TaskActionItem[]
  events            Event[]
  meetings          Meeting[]
  meetingMinutes    MeetingMinute[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]
  clients           Client[]
  employeeProfiles  EmployeeProfile[]
  payrollRecords    PayrollRecord[]

  @@index([isActive])
  @@index([code])
  @@map("organizations")
}

// Users - Core employee management with HR optimization
model User {
  id             String   @id @default(uuid())
  employeeId     String?  @unique @map("employee_id") @db.VarChar(20) // HR employee ID
  name           String   @db.VarChar(255)
  email          String   @unique @db.VarChar(255)
  password       String?  @db.VarChar(255)
  role           Role     @default(EMPLOYEE)
  department     String?  @db.VarChar(100)
  designation    String?  @db.VarChar(100)
  managerId      String?  @map("manager_id") // Direct manager for hierarchy
  organizationId String   @map("organization_id")
  isActive       Boolean  @default(true) @map("is_active")
  joinDate       DateTime? @map("join_date") // HR requirement
  terminationDate DateTime? @map("termination_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager               User?              @relation("ManagerSubordinate", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates          User[]             @relation("ManagerSubordinate")
  employeeProfile       EmployeeProfile?
  payrollRecords        PayrollRecord[]
  travelRequests        TravelRequest[]    @relation("EmployeeRequests")
  approvedRequests      TravelRequest[]    @relation("ApproverRequests")
  valleyRequests        ValleyRequest[]    @relation("ValleyEmployeeRequests")
  approvedValleyRequests ValleyRequest[]   @relation("ValleyApproverRequests")
  notifications         Notification[]
  timeLogs              TimeLog[]
  createdTasks          Task[]             @relation("TaskCreator")
  assignedTasks         Task[]             @relation("TaskAssignee")
  lastUpdatedTasks      Task[]             @relation("TaskLastUpdater")
  taskActionItems       TaskActionItem[]   @relation("ActionItemAssignee")
  createdActionItems    TaskActionItem[]   @relation("ActionItemCreator")
  updatedActionItems    TaskActionItem[]   @relation("ActionItemUpdater")
  taskUpdates           TaskUpdate[]       @relation("TaskUpdateUser")
  createdEvents         Event[]
  createdMeetings       Meeting[]          @relation("MeetingCreator")
  assignedMeetings      Meeting[]          @relation("MeetingAssignee")
  meetingMinutes        MeetingMinute[]    @relation("MinuteAssignee")
  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]     @relation("LeaveEmployee")
  approvedLeaves        LeaveRequest[]     @relation("LeaveApprover")

  @@index([organizationId, isActive])
  @@index([employeeId])
  @@index([email])
  @@index([role, organizationId])
  @@index([department, organizationId])
  @@index([managerId])
  @@map("users")
}

enum Role {
  EMPLOYEE
  MANAGER
  APPROVER
  CHECKER
  FINANCE
  HR_ADMIN
  ADMIN
  SUPER_ADMIN

  @@map("role")
}

// HR-specific Employee Profile for detailed HR management
model EmployeeProfile {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  personalEmail     String?   @db.VarChar(255) @map("personal_email")
  phone             String?   @db.VarChar(20)
  emergencyContact  String?   @db.VarChar(100) @map("emergency_contact")
  emergencyPhone    String?   @db.VarChar(20) @map("emergency_phone")
  address           String?   @db.Text
  dateOfBirth       DateTime? @map("date_of_birth")
  nationality       String?   @db.VarChar(50)
  maritalStatus     MaritalStatus? @map("marital_status")
  
  // Employment Details
  employmentType    EmploymentType @map("employment_type") @default(FULL_TIME)
  salary            Decimal?  @db.Decimal(12,2)
  salaryGrade       String?   @db.VarChar(10) @map("salary_grade")
  probationEndDate  DateTime? @map("probation_end_date")
  
  // Leave Balances (HR Management)
  annualLeaveBalance    Int @default(0) @map("annual_leave_balance")
  sickLeaveBalance      Int @default(0) @map("sick_leave_balance")
  personalLeaveBalance  Int @default(0) @map("personal_leave_balance")
  
  // Bank Details
  bankName          String?   @db.VarChar(100) @map("bank_name")
  accountNumber     String?   @db.VarChar(50) @map("account_number")
  ifscCode          String?   @db.VarChar(15) @map("ifsc_code")
  
  organizationId    String    @map("organization_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employmentType])
  @@map("employee_profiles")
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  
  @@map("marital_status")
}

enum EmploymentType {
  FULL_TIME    @map("full_time")
  PART_TIME    @map("part_time")
  CONTRACT     @map("contract")
  CONSULTANT   @map("consultant")
  INTERN       @map("intern")
  
  @@map("employment_type")
}

// Payroll Records for HR Management
model PayrollRecord {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  payPeriod           String   @db.VarChar(20) @map("pay_period") // "2024-01" format
  basicSalary         Decimal  @map("basic_salary") @db.Decimal(12,2)
  allowances          Decimal  @default(0) @db.Decimal(12,2)
  deductions          Decimal  @default(0) @db.Decimal(12,2)
  travelReimbursement Decimal  @default(0) @map("travel_reimbursement") @db.Decimal(12,2)
  overtimePay         Decimal  @default(0) @map("overtime_pay") @db.Decimal(12,2)
  bonus               Decimal  @default(0) @db.Decimal(12,2)
  grossPay            Decimal  @map("gross_pay") @db.Decimal(12,2)
  netPay              Decimal  @map("net_pay") @db.Decimal(12,2)
  status              PayrollStatus @default(DRAFT)
  processedDate       DateTime? @map("processed_date")
  organizationId      String   @map("organization_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, payPeriod])
  @@index([organizationId, payPeriod])
  @@index([status])
  @@map("payroll_records")
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
  
  @@map("payroll_status")
}

// ======================================
// TRAVEL & EXPENSE MANAGEMENT
// ======================================

// Travel Requests
model TravelRequest {
  id                         String   @id @default(uuid())
  employeeId                 String   @map("employee_id")
  employeeName               String   @map("employee_name")
  department                 String
  designation                String
  requestType                RequestType @map("request_type")
  
  // Travel details
  project                    String
  projectOther               String?  @map("project_other")
  purpose                    String
  purposeType                String?  @map("purpose_type")
  purposeOther               String?  @map("purpose_other")
  location                   String
  locationOther              String?  @map("location_other")
  travelDateFrom             String   @map("travel_date_from") // Using String to match existing API
  travelDateTo               String   @map("travel_date_to")
  
  // Transportation details
  transportMode              String   @map("transport_mode")
  stationPickDrop            String   @map("station_pick_drop")
  localConveyance            String   @map("local_conveyance")
  rideShareUsed              Boolean  @default(false) @map("ride_share_used")
  ownVehicleReimbursement    Boolean  @default(false) @map("own_vehicle_reimbursement")
  
  // Financial details
  totalAmount                Decimal  @map("total_amount") @db.Decimal(10,2)
  previousOutstandingAdvance Decimal? @map("previous_outstanding_advance") @db.Decimal(10,2)
  
  // Group travel details
  isGroupTravel              Boolean? @default(false) @map("is_group_travel")
  isGroupCaptain             Boolean? @default(false) @map("is_group_captain")
  groupSize                  String?  @map("group_size")
  groupMembers               String?  @map("group_members") // Comma-separated string
  groupDescription           String?  @map("group_description")
  
  // Advance request details
  estimatedAmount            String?  @map("estimated_amount")
  advanceNotes               String?  @map("advance_notes")
  
  // Emergency request details
  emergencyReason            String?  @map("emergency_reason")
  emergencyReasonOther       String?  @map("emergency_reason_other")
  emergencyJustification     String?  @map("emergency_justification")
  emergencyAmount            String?  @map("emergency_amount")
  
  // Processing flags
  needsFinancialAttention    Boolean? @default(false) @map("needs_financial_attention")
  isUrgent                   Boolean? @default(false) @map("is_urgent")
  
  // Status and phase
  status                     RequestStatus @default(PENDING)
  phase                      Int       @default(1)
  
  // Approver information
  approverId                 String    @map("approver_id")
  approverComments           String?   @map("approver_comments")
  checkerComments            String?   @map("checker_comments")
  financeComments            String?   @map("finance_comments")
  
  // Valley-specific fields (for compatibility)
  expenseDate                String?   @map("expense_date")
  description                String?
  paymentMethod              String?   @map("payment_method")
  meetingType                String?   @map("meeting_type")
  meetingParticipants        String?   @map("meeting_participants")
  
  // Timestamps
  organizationId             String    @map("organization_id")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  travelDetailsApprovedAt    DateTime? @map("travel_details_approved_at")
  expensesSubmittedAt        DateTime? @map("expenses_submitted_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User         @relation("EmployeeRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     User         @relation("ApproverRequests", fields: [approverId], references: [id], onDelete: Restrict)
  expenseItems ExpenseItem[]
  notifications Notification[]

  @@index([organizationId, status])
  @@index([employeeId, createdAt])
  @@index([approverId, status])
  @@index([status, phase])
  @@index([requestType, organizationId])
  @@index([createdAt(sort: Desc)]) // HR reporting optimization
  @@map("travel_requests")
}

enum RequestType {
  NORMAL     @map("normal")
  ADVANCE    @map("advance")
  EMERGENCY  @map("emergency")
  GROUP      @map("group")
  IN_VALLEY  @map("in-valley")

  @@map("request_type")
}

enum RequestStatus {
  PENDING              @map("pending")
  TRAVEL_APPROVED      @map("travel_approved")
  PENDING_VERIFICATION @map("pending_verification")
  APPROVED             @map("approved")
  REJECTED             @map("rejected")
  REJECTED_BY_CHECKER  @map("rejected_by_checker")

  @@map("request_status")
}

// Valley Requests (In-Valley Travel Requests)
model ValleyRequest {
  id                    String   @id @default(uuid())
  employeeId            String   @map("employee_id")
  employeeName          String   @map("employee_name")
  department            String
  designation           String
  requestType           String   @default("in-valley") @map("request_type")
  
  // Valley-specific details
  project               String
  purpose               String
  expenseDate           String   @map("expense_date") // String to match API
  location              String
  description           String
  paymentMethod         String   @map("payment_method")
  meetingType           String?  @map("meeting_type")
  meetingParticipants   String?  @map("meeting_participants")
  totalAmount           Decimal  @map("total_amount") @db.Decimal(10,2)
  
  // Status and approval
  status                RequestStatus @default(PENDING)
  travelDateFrom        String   @map("travel_date_from")
  travelDateTo          String   @map("travel_date_to")
  approverId            String   @map("approver_id")
  
  // Organization and timestamps
  organizationId        String   @map("organization_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       User            @relation("ValleyEmployeeRequests", fields: [employeeId], references: [id], onDelete: Cascade)
  approver       User            @relation("ValleyApproverRequests", fields: [approverId], references: [id], onDelete: Restrict)
  valleyExpenses ValleyExpense[]
  valleyReceipts ValleyReceipt[]

  @@map("valley_requests")
}

// Expense Items (for Travel Requests)
model ExpenseItem {
  id             String         @id @default(uuid())
  requestId      String         @map("request_id")
  category       ExpenseCategory
  amount         Decimal        @db.Decimal(10,2)
  description    String?
  status         String         @default("pending")
  organizationId String         @map("organization_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  travelRequest  TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  receipts       Receipt[]

  @@map("expense_items")
}

// Valley Expenses (for Valley Requests)
model ValleyExpense {
  id             String        @id @default(uuid())
  requestId      String        @map("request_id")
  category       ExpenseCategory
  amount         Decimal       @db.Decimal(10,2)
  description    String?
  status         String        @default("pending")
  organizationId String        @map("organization_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  valleyRequest  ValleyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  receipts       ValleyReceipt[]

  @@map("valley_expenses")
}

enum ExpenseCategory {
  ACCOMMODATION     @map("accommodation")
  PER_DIEM         @map("per-diem")
  VEHICLE_HIRING   @map("vehicle-hiring")
  PROGRAM_COST     @map("program-cost")
  MEETING_COST     @map("meeting-cost")
  OTHER            @map("other")
  RIDE_SHARE       @map("ride-share")
  TAXI             @map("taxi")
  FOOD             @map("food")
  MEETING_VENUE    @map("meeting-venue")
  STATIONERY       @map("stationery")
  PRINTING         @map("printing")
  COURIER          @map("courier")

  @@map("expense_category")
}

// Receipts (for Travel Request Expenses) - HR Optimized
model Receipt {
  id               String      @id @default(uuid())
  expenseItemId    String      @map("expense_item_id")
  originalFilename String      @map("original_filename") @db.VarChar(255)
  storedFilename   String      @map("stored_filename") @db.VarChar(255)
  fileType         String      @map("file_type") @db.VarChar(50)
  fileSize         Int?        @map("file_size") // File size in bytes for HR tracking
  storagePath      String?     @map("storage_path") @db.VarChar(500)
  publicUrl        String?     @map("public_url") @db.VarChar(500)
  organizationId   String      @map("organization_id")
  uploadedBy       String?     @map("uploaded_by") // Track who uploaded for audit
  createdAt        DateTime    @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseItem  ExpenseItem  @relation(fields: [expenseItemId], references: [id], onDelete: Cascade)

  @@index([expenseItemId])
  @@index([organizationId, createdAt])
  @@map("receipts")
}

// Valley Receipts (for Valley Request Expenses) - HR Optimized
model ValleyReceipt {
  id               String        @id @default(uuid())
  valleyRequestId  String        @map("valley_request_id") // Link directly to valley request
  valleyExpenseId  String?       @map("valley_expense_id") // Optional link to specific expense
  originalFilename String        @map("original_filename") @db.VarChar(255)
  storedFilename   String        @map("stored_filename") @db.VarChar(255)
  fileType         String        @map("file_type") @db.VarChar(50)
  fileSize         Int?          @map("file_size") // File size in bytes
  storagePath      String?       @map("storage_path") @db.VarChar(500)
  publicUrl        String?       @map("public_url") @db.VarChar(500)
  organizationId   String        @map("organization_id")
  uploadedBy       String?       @map("uploaded_by") // Track who uploaded
  createdAt        DateTime      @default(now()) @map("created_at")

  // Relations
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  valleyRequest ValleyRequest @relation(fields: [valleyRequestId], references: [id], onDelete: Cascade)
  valleyExpense ValleyExpense? @relation(fields: [valleyExpenseId], references: [id], onDelete: SetNull)

  @@index([valleyRequestId])
  @@index([organizationId, createdAt])
  @@map("valley_receipts")
}

// Notifications
model Notification {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  requestId      String?        @map("request_id")
  message        String
  isRead         Boolean        @default(false) @map("is_read")
  requestType    String?        @map("request_type")
  organizationId String         @map("organization_id")
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelRequest TravelRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// Projects
model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  active         Boolean      @default(true)
  organizationId String       @map("organization_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgets      Budget[]

  @@map("projects")
}

// Budgets
model Budget {
  id           String      @id @default(uuid())
  projectId    String      @map("project_id")
  amount       Decimal     @db.Decimal(15,2)
  fiscalYear   Int         @map("fiscal_year")
  description  String?
  organizationId String    @map("organization_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

// Departments
model Department {
  id             String   @id @default(uuid())
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@map("departments")
}

// Tasks
model Task {
  id                    String         @id @default(uuid())
  title                 String
  description           String?
  departmentId          String         @map("department_id")
  departmentName        String?        @map("department_name")
  assignedTo            String[]       @map("assigned_to") // Array of names
  assignedUserIds       String[]       @map("assigned_user_ids") // Array of user IDs
  status                TaskStatus     @default(NOT_STARTED)
  priority              TaskPriority   @default(MEDIUM)
  ragStatus             RagStatus      @default(UNRATED) @map("rag_status")
  dueDate               String?        @map("due_date") // String to match API
  startDate             String?        @map("start_date")
  completionDate        String?        @map("completion_date")
  bottlenecks           String?
  ragTakeaway           String?        @map("rag_takeaway")
  remarks               String?
  createdBy             String?        @map("created_by")
  createdByName         String?        @map("created_by_name")
  lastUpdatedBy         String?        @map("last_updated_by")
  lastUpdatedByName     String?        @map("last_updated_by_name")
  organizationId        String         @map("organization_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  
  // Meeting action item fields
  isMeetingActionItem   Boolean?       @default(false) @map("is_meeting_action_item")
  meetingActionItemId   String?        @map("meeting_action_item_id")
  meetingId             String?        @map("meeting_id")
  meetingTitle          String?        @map("meeting_title")

  // Relations
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  creator         User?            @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignees       User[]           @relation("TaskAssignee")
  lastUpdater     User?            @relation("TaskLastUpdater", fields: [lastUpdatedBy], references: [id], onDelete: SetNull)
  actionItems     TaskActionItem[]
  taskUpdates     TaskUpdate[]
  timeLogs        TimeLog[]
  meeting         Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

enum TaskStatus {
  NOT_STARTED @map("Not Started")
  IN_PROGRESS @map("In Progress")
  COMPLETED   @map("Completed")
  ON_HOLD     @map("On Hold")
  CANCELLED   @map("Cancelled")

  @@map("task_status")
}

enum TaskPriority {
  LOW      @map("Low")
  MEDIUM   @map("Medium")
  HIGH     @map("High")
  CRITICAL @map("Critical")

  @@map("task_priority")
}

enum RagStatus {
  RED     @map("Red")
  AMBER   @map("Amber")
  GREEN   @map("Green")
  UNRATED @map("Unrated")

  @@map("rag_status")
}

// Task Action Items
model TaskActionItem {
  id               String         @id @default(uuid())
  taskId           String         @map("task_id")
  organizationId   String         @map("organization_id")
  serialNo         Int            @map("serial_no")
  title            String
  description      String?
  assignedToId     String         @map("assigned_to_id")
  assignedToName   String         @map("assigned_to_name")
  priority         TaskPriority   @default(MEDIUM)
  status           TaskStatus     @default(NOT_STARTED)
  dueDate          String?        @map("due_date") // String to match API
  remarks          String?
  createdBy        String         @map("created_by")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedBy        String?        @map("updated_by")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee     User         @relation("ActionItemAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  creator      User         @relation("ActionItemCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater      User?        @relation("ActionItemUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("task_action_items")
}

// Task Updates
model TaskUpdate {
  id             String   @id @default(uuid())
  taskId         String   @map("task_id")
  updateType     String   @map("update_type")
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  remarks        String?
  updatedBy      String?  @map("updated_by")
  updatedByName  String   @map("updated_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updater User? @relation("TaskUpdateUser", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("task_updates")
}

// Time Logs
model TimeLog {
  id                   String     @id @default(uuid())
  userId               String     @map("user_id")
  taskId               String?    @map("task_id")
  organizationId       String     @map("organization_id")
  taskType             TaskType   @map("task_type")
  description          String
  date                 String     // String to match API format
  hoursSpent           Decimal    @map("hours_spent") @db.Decimal(5,2)
  userName             String     @map("user_name")
  meetingActionItemId  String?    @map("meeting_action_item_id")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("time_logs")
}

enum TaskType {
  DESK_RESEARCH                @map("Desk Research")
  FIELD_VISIT                  @map("Field Visit")
  REPORT_WRITING              @map("Report Writing")
  INTERVIEW_CONSULTATION      @map("Interview/Consultation Meetings")
  VISUALS_DESIGNING           @map("Visuals and Designing")
  DATA_ANALYSIS               @map("Data Analysis/Interpretation")
  FINANCE_ADMINISTRATIVE      @map("Finance/Administrative Tasks")

  @@map("task_type")
}

// Events
model Event {
  id               String      @id @default(uuid())
  title            String
  description      String?
  startDate        String      @map("start_date") // String to match API
  endDate          String      @map("end_date")
  startTime        String?     @map("start_time") // "14:30" format
  endTime          String?     @map("end_time")   // "16:00" format
  isAllDay         Boolean?    @default(false) @map("is_all_day")
  eventType        EventType   @map("event_type")
  location         String?
  hallId           String?     @map("hall_id")
  createdBy        String      @map("created_by")
  createdByName    String      @map("created_by_name")
  createdByRole    String      @map("created_by_role")
  maxAttendees     Int?        @map("max_attendees")
  currentAttendees Int?        @default(0) @map("current_attendees")
  requiresApproval Boolean?    @default(false) @map("requires_approval")
  approvalStatus   ApprovalStatus? @default(APPROVED) @map("approval_status")
  organizationId   String      @map("organization_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("events")
}

enum EventType {
  COMPANY_MEETING @map("company_meeting")
  HALL_BOOKING    @map("hall_booking")
  POTLUCK         @map("potluck")
  TRAINING        @map("training")
  HOLIDAY         @map("holiday")
  DEADLINE        @map("deadline")
  ANNOUNCEMENT    @map("announcement")
  BIRTHDAY        @map("birthday")
  TEAM_OUTING     @map("team_outing")
  WORKSHOP        @map("workshop")
  GENERAL         @map("general")

  @@map("event_type")
}

enum ApprovalStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("approval_status")
}

// Meetings
model Meeting {
  id                     String          @id @default(uuid())
  title                  String
  description            String?
  taskId                 String?         @map("task_id")
  meetingType            MeetingType     @map("meeting_type")
  clientId               String?         @map("client_id")
  location               String?
  locationType           LocationType    @map("location_type")
  latitude               Float?
  longitude              Float?
  locationAddress        String?         @map("location_address")
  meetingDate            String          @map("meeting_date") // String to match API
  meetingTime            String          @map("meeting_time") // "14:00:00" format
  durationMinutes        Int             @map("duration_minutes")
  createdBy              String          @map("created_by")
  createdByName          String          @map("created_by_name")
  assignedTo             String          @map("assigned_to")
  assignedToName         String          @map("assigned_to_name")
  deadlineDate           String          @map("deadline_date")
  deadlineTime           String          @map("deadline_time")
  priority               TaskPriority    @default(MEDIUM)
  status                 MeetingStatus   @default(SCHEDULED)
  organizationId         String          @map("organization_id")
  actionItemsCount       Int             @default(0) @map("action_items_count")
  completedActionItems   Int             @default(0) @map("completed_action_items")
  attendeeCount          Int             @default(0) @map("attendee_count")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User            @relation("MeetingCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignee       User            @relation("MeetingAssignee", fields: [assignedTo], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks          Task[]
  meetingMinutes MeetingMinute[]

  @@map("meetings")
}

enum MeetingType {
  INTERNAL @map("internal")
  EXTERNAL @map("external")

  @@map("meeting_type")
}

enum LocationType {
  OFFICE   @map("office")
  EXTERNAL @map("external")

  @@map("location_type")
}

enum MeetingStatus {
  SCHEDULED @map("scheduled")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("meeting_status")
}

// Meeting Minutes (Action Items)
model MeetingMinute {
  id               String         @id @default(uuid())
  meetingId        String         @map("meeting_id")
  serialNo         Int            @map("serial_no")
  responsibility   String
  assignedToId     String         @map("assigned_to_id")
  assignedToName   String         @map("assigned_to_name")
  deadline         String         // String to match API format
  remarks          String?
  isDone           Boolean        @default(false) @map("is_done")
  organizationId   String         @map("organization_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee     User         @relation("MinuteAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  @@map("meeting_minutes")
}

// Clients
model Client {
  id             String    @id @default(uuid())
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  organizationId String    @map("organization_id")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meetings     Meeting[]

  @@map("clients")
}

// Attendance Records
model AttendanceRecord {
  id               String           @id @default(uuid())
  employeeId       String           @map("employee_id")
  employeeName     String           @map("employee_name")
  date             String           // String to match API format
  status           AttendanceStatus
  leaveType        LeaveType?       @map("leave_type")
  leaveReason      String?          @map("leave_reason")
  approver         String?
  isAdvancedLeave  Boolean?         @default(false) @map("is_advanced_leave")
  organizationId   String           @map("organization_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT @map("present")
  LEAVE   @map("leave")

  @@map("attendance_status")
}

// Leave Requests
model LeaveRequest {
  id           String      @id @default(uuid())
  employeeId   String      @map("employee_id")
  employeeName String      @map("employee_name")
  department   String
  leaveType    LeaveType   @map("leave_type")
  reason       String
  approverId   String      @map("approver_id")
  approverName String?     @map("approver_name")
  status       RequestStatus @default(PENDING)
  isAdvanced   Boolean?    @default(false) @map("is_advanced")
  organizationId String    @map("organization_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User         @relation("LeaveEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     User         @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@map("leave_requests")
}

enum LeaveType {
  SICK      @map("sick")
  PERSONAL  @map("personal")
  VACATION  @map("vacation")
  EMERGENCY @map("emergency")
  OTHER     @map("other")

  @@map("leave_type")
}